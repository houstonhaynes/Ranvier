<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <PackageId>Fable.Ranvier.Dom</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Fable.Ranvier.Dom.Traced</PackageId>
    <AssemblyName>Ranvier.Dom</AssemblyName>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Version>0.1.0-alpha.54</Version>
    <Description>Fable DOM contracts sharing Ranvier.Dom's generated WebKit interface sources.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Ranvier.Dom/Generated/Dom.fs" Link="Generated/Dom.fs" />
    <Compile Include="../Ranvier.Dom/SvgPaths.fs" Link="SvgPaths.fs" />
    <Compile Include="../Ranvier.Dom/SvgViews.fs" Link="SvgViews.fs" />
    <Compile Include="BrowserSvgViews.fs" />
    <Compile Include="../Ranvier.Dom/StyleSheets.fs" Link="StyleSheets.fs" />
    <Compile Include="BrowserStyleSheets.fs" />
    <Compile Include="../Ranvier.Dom/CSS.fs" Link="CSS.fs" />
    <Compile Include="../Ranvier.Dom/CssQueries.fs" Link="CssQueries.fs" />
    <Compile Include="BrowserCssQueries.fs" />
    <Compile Include="../Ranvier.Dom/CustomProperties.fs" Link="CustomProperties.fs" />
    <Compile Include="BrowserCustomProperties.fs" />
    <Compile Include="../Ranvier.Dom/StyleValues.fs" Link="StyleValues.fs" />
    <Compile Include="BrowserStyleValues.fs" />
    <Compile Include="../Ranvier.Dom/StyleMaps.fs" Link="StyleMaps.fs" />
    <Compile Include="BrowserStyleMaps.fs" />
    <Compile Include="../Ranvier.Dom/Geometry.fs" Link="Geometry.fs" />
    <Compile Include="BrowserGeometry.fs" />
    <Compile Include="../Ranvier.Dom/TransformValues.fs" Link="TransformValues.fs" />
    <Compile Include="BrowserTransformValues.fs" />
    <Compile Include="../Ranvier.Dom/ComputedStyles.fs" Link="ComputedStyles.fs" />
    <Compile Include="BrowserComputedStyles.fs" />
    <Compile Include="../Ranvier.Dom/Timing.fs" Link="Timing.fs" />
    <Compile Include="BrowserTiming.fs" />
    <Compile Include="../Ranvier.Dom/Locales.fs" Link="Locales.fs" />
    <Compile Include="BrowserLocales.fs" />
    <Compile Include="../Ranvier.Dom/Capabilities.fs" Link="Capabilities.fs" />
    <Compile Include="BrowserCapabilities.fs" />
    <Compile Include="../Ranvier.Dom/Cancellation.fs" Link="Cancellation.fs" />
    <Compile Include="BrowserCancellation.fs" />
    <Compile Include="../Ranvier.Dom/Resources.fs" Link="Resources.fs" />
    <Compile Include="BrowserResources.fs" />
    <Compile Include="../Ranvier.Dom/Fonts.fs" Link="Fonts.fs" />
    <Compile Include="BrowserFonts.fs" />
    <Compile Include="../Ranvier.Dom/BinaryValues.fs" Link="BinaryValues.fs" />
    <Compile Include="BrowserBinaryValues.fs" />
    <Compile Include="../Ranvier.Dom/DataTransfers.fs" Link="DataTransfers.fs" />
    <Compile Include="BrowserDataTransfers.fs" />
    <Compile Include="../Ranvier.Dom/BlobUrls.fs" Link="BlobUrls.fs" />
    <Compile Include="BrowserBlobUrls.fs" />
    <Compile Include="../Ranvier.Dom/MediaCapabilities.fs" Link="MediaCapabilities.fs" />
    <Compile Include="BrowserMediaCapabilities.fs" />
    <Compile Include="../Ranvier.Dom/Snapshots.fs" Link="Snapshots.fs" />
    <Compile Include="BrowserSnapshots.fs" />
    <Compile Include="../Ranvier.Dom/EventConstruction.fs" Link="EventConstruction.fs" />
    <Compile Include="BrowserEvents.fs" />
    <Compile Include="../Ranvier.Dom/InputState.fs" Link="InputState.fs" />
    <Compile Include="BrowserInput.fs" />
    <Compile Include="../Ranvier.Dom/PointerInput.fs" Link="PointerInput.fs" />
    <Compile Include="BrowserPointerInput.fs" />
    <Compile Include="../Ranvier.Dom/Viewport.fs" Link="Viewport.fs" />
    <Compile Include="BrowserViewport.fs" />
    <Compile Include="../Ranvier.Dom/MediaQueries.fs" Link="MediaQueries.fs" />
    <Compile Include="BrowserMediaQueries.fs" />
    <Compile Include="../Ranvier.Dom/ViewportScroll.fs" Link="ViewportScroll.fs" />
    <Compile Include="BrowserViewportScroll.fs" />
    <Compile Include="../Ranvier.Dom/VisualViewport.fs" Link="VisualViewport.fs" />
    <Compile Include="BrowserVisualViewport.fs" />
    <Compile Include="../Ranvier.Dom/FormData.fs" Link="FormData.fs" />
    <Compile Include="BrowserForms.fs" />
    <Compile Include="../Ranvier.Dom/FormSubmission.fs" Link="FormSubmission.fs" />
    <Compile Include="BrowserFormSubmission.fs" />
    <Compile Include="../Ranvier.Dom/ToggleEvents.fs" Link="ToggleEvents.fs" />
    <Compile Include="BrowserToggleEvents.fs" />
    <Compile Include="../Ranvier.Dom/EventDetails.fs" Link="EventDetails.fs" />
    <Compile Include="BrowserEventDetails.fs" />
    <Compile Include="../Ranvier.Dom/Urls.fs" Link="Urls.fs" />
    <Compile Include="BrowserUrls.fs" />
    <Compile Include="../Ranvier.Dom/Crypto.fs" Link="Crypto.fs" />
    <Compile Include="BrowserCrypto.fs" />
    <Compile Include="../Ranvier.Dom/Screen.fs" Link="Screen.fs" />
    <Compile Include="BrowserScreen.fs" />
    <Compile Include="../Ranvier.Dom/Highlights.fs" Link="Highlights.fs" />
    <Compile Include="BrowserHighlights.fs" />
    <Compile Include="../Ranvier.Dom/Diagnostics.fs" Link="Diagnostics.fs" />
    <Compile Include="BrowserDiagnostics.fs" />
    <Compile Include="../Ranvier.Dom/Coordinates.fs" Link="Coordinates.fs" />
    <Compile Include="BrowserCoordinates.fs" />
    <Compile Include="../Ranvier.Dom/ResizeObservation.fs" Link="ResizeObservation.fs" />
    <Compile Include="BrowserResizeObservation.fs" />
    <Compile Include="../Ranvier.Dom/IntersectionObservation.fs" Link="IntersectionObservation.fs" />
    <Compile Include="BrowserIntersectionObservation.fs" />
    <Compile Include="../Ranvier.Dom/TextSegmentation.fs" Link="TextSegmentation.fs" />
    <Compile Include="BrowserTextSegmentation.fs" />
    <Compile Include="../Ranvier.Dom/Frames.fs" Link="Frames.fs" />
    <Compile Include="BrowserFrames.fs" />
    <Compile Include="../Ranvier.Dom/Canvas.fs" Link="Canvas.fs" />
    <Compile Include="BrowserCanvas.fs" />
    <Compile Include="../Ranvier.Dom/CanvasPixels.fs" Link="CanvasPixels.fs" />
    <Compile Include="BrowserCanvasPixels.fs" />
    <Compile Include="../Ranvier.Dom/CanvasExport.fs" Link="CanvasExport.fs" />
    <Compile Include="BrowserCanvasExport.fs" />
    <Compile Include="BrowserIdle.fs" />
    <Compile Include="../Ranvier.Dom/ValueFactories.fs" Link="ValueFactories.fs" />
    <Compile Include="BrowserValueFactories.fs" />
    <Compile Include="../Ranvier.Dom/WakeLocks.fs" Link="WakeLocks.fs" />
    <Compile Include="BrowserWakeLocks.fs" />
    <Compile Include="../Ranvier.Dom/Notifications.fs" Link="Notifications.fs" />
    <Compile Include="BrowserNotifications.fs" />
    <Compile Include="../Ranvier.Dom/Animations.fs" Link="Animations.fs" />
    <Compile Include="BrowserAnimations.fs" />
    <Compile Include="../Ranvier.Dom/Timelines.fs" Link="Timelines.fs" />
    <Compile Include="BrowserTimelines.fs" />
    <Compile Include="../Ranvier.Dom/CustomEffects.fs" Link="CustomEffects.fs" />
    <Compile Include="BrowserCustomEffects.fs" />
    <PackageReference Include="Fable.Core" Version="5.3.0" />
    <None Include="../Ranvier.Dom/README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
  <Target Name="PackageSharedDomSource" AfterTargets="CreateStandaloneFableProject">
    <ItemGroup>
      <_PackageFiles Update="@(_PackageFiles)" Condition="'%(_PackageFiles.Extension)' == '.fs' and '%(_PackageFiles.Filename)' == 'Dom'">
        <PackagePath>fable/Generated/Dom.fs</PackagePath>
      </_PackageFiles>
      <_PackageFiles Update="@(_PackageFiles)" Condition="'%(_PackageFiles.Extension)' == '.fs' and '%(_PackageFiles.Filename)' != 'Dom'">
        <PackagePath>fable/%(_PackageFiles.Filename)%(_PackageFiles.Extension)</PackagePath>
      </_PackageFiles>
    </ItemGroup>
    <WriteLinesToFile File="$(NuspecOutputPath)fable/$(MSBuildProjectFile)" Overwrite="true"
                      Lines="&lt;Project Sdk=&quot;Microsoft.NET.Sdk&quot;&gt;;  &lt;PropertyGroup&gt;;    &lt;TargetFramework&gt;netstandard2.1&lt;/TargetFramework&gt;;    &lt;AssemblyName&gt;Ranvier.Dom&lt;/AssemblyName&gt;;  &lt;/PropertyGroup&gt;;  &lt;ItemGroup&gt;;    &lt;Compile Include=&quot;Generated/Dom.fs&quot; /&gt;;    &lt;Compile Include=&quot;SvgPaths.fs&quot; /&gt;;    &lt;Compile Include=&quot;SvgViews.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserSvgViews.fs&quot; /&gt;;    &lt;Compile Include=&quot;StyleSheets.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserStyleSheets.fs&quot; /&gt;;    &lt;Compile Include=&quot;CSS.fs&quot; /&gt;;    &lt;Compile Include=&quot;CssQueries.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCssQueries.fs&quot; /&gt;;    &lt;Compile Include=&quot;CustomProperties.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCustomProperties.fs&quot; /&gt;;    &lt;Compile Include=&quot;StyleValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserStyleValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;StyleMaps.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserStyleMaps.fs&quot; /&gt;;    &lt;Compile Include=&quot;Geometry.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserGeometry.fs&quot; /&gt;;    &lt;Compile Include=&quot;TransformValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserTransformValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;ComputedStyles.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserComputedStyles.fs&quot; /&gt;;    &lt;Compile Include=&quot;Timing.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserTiming.fs&quot; /&gt;;    &lt;Compile Include=&quot;Locales.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserLocales.fs&quot; /&gt;;    &lt;Compile Include=&quot;Capabilities.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCapabilities.fs&quot; /&gt;;    &lt;Compile Include=&quot;Cancellation.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCancellation.fs&quot; /&gt;;    &lt;Compile Include=&quot;Resources.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserResources.fs&quot; /&gt;;    &lt;Compile Include=&quot;Fonts.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserFonts.fs&quot; /&gt;;    &lt;Compile Include=&quot;BinaryValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserBinaryValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;DataTransfers.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserDataTransfers.fs&quot; /&gt;;    &lt;Compile Include=&quot;BlobUrls.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserBlobUrls.fs&quot; /&gt;;    &lt;Compile Include=&quot;MediaCapabilities.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserMediaCapabilities.fs&quot; /&gt;;    &lt;Compile Include=&quot;Snapshots.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserSnapshots.fs&quot; /&gt;;    &lt;Compile Include=&quot;EventConstruction.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserEvents.fs&quot; /&gt;;    &lt;Compile Include=&quot;InputState.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserInput.fs&quot; /&gt;;    &lt;Compile Include=&quot;PointerInput.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserPointerInput.fs&quot; /&gt;;    &lt;Compile Include=&quot;Viewport.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserViewport.fs&quot; /&gt;;    &lt;Compile Include=&quot;MediaQueries.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserMediaQueries.fs&quot; /&gt;;    &lt;Compile Include=&quot;ViewportScroll.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserViewportScroll.fs&quot; /&gt;;    &lt;Compile Include=&quot;VisualViewport.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserVisualViewport.fs&quot; /&gt;;    &lt;Compile Include=&quot;FormData.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserForms.fs&quot; /&gt;;    &lt;Compile Include=&quot;FormSubmission.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserFormSubmission.fs&quot; /&gt;;    &lt;Compile Include=&quot;ToggleEvents.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserToggleEvents.fs&quot; /&gt;;    &lt;Compile Include=&quot;EventDetails.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserEventDetails.fs&quot; /&gt;;    &lt;Compile Include=&quot;TextSegmentation.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserTextSegmentation.fs&quot; /&gt;;    &lt;Compile Include=&quot;Urls.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserUrls.fs&quot; /&gt;;    &lt;Compile Include=&quot;Crypto.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCrypto.fs&quot; /&gt;;    &lt;Compile Include=&quot;Highlights.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserHighlights.fs&quot; /&gt;;    &lt;Compile Include=&quot;Diagnostics.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserDiagnostics.fs&quot; /&gt;;    &lt;Compile Include=&quot;Coordinates.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCoordinates.fs&quot; /&gt;;    &lt;Compile Include=&quot;ResizeObservation.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserResizeObservation.fs&quot; /&gt;;    &lt;Compile Include=&quot;IntersectionObservation.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserIntersectionObservation.fs&quot; /&gt;;    &lt;Compile Include=&quot;Screen.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserScreen.fs&quot; /&gt;;    &lt;Compile Include=&quot;Frames.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserFrames.fs&quot; /&gt;;    &lt;Compile Include=&quot;Canvas.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCanvas.fs&quot; /&gt;;    &lt;Compile Include=&quot;CanvasPixels.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCanvasPixels.fs&quot; /&gt;;    &lt;Compile Include=&quot;CanvasExport.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCanvasExport.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserIdle.fs&quot; /&gt;;    &lt;Compile Include=&quot;Animations.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserAnimations.fs&quot; /&gt;;    &lt;Compile Include=&quot;Timelines.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserTimelines.fs&quot; /&gt;;    &lt;Compile Include=&quot;CustomEffects.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCustomEffects.fs&quot; /&gt;;    &lt;Compile Include=&quot;Notifications.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserNotifications.fs&quot; /&gt;;    &lt;Compile Include=&quot;WakeLocks.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserWakeLocks.fs&quot; /&gt;;    &lt;Compile Include=&quot;ValueFactories.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserValueFactories.fs&quot; /&gt;;  &lt;/ItemGroup&gt;;&lt;/Project&gt;" />
  </Target>
</Project>
