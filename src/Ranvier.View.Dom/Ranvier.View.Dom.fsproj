<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
        <OutputType>Library</OutputType>
        <RootNamespace>Ranvier.View.Dom</RootNamespace>
        <AssemblyName>Ranvier.View.Dom</AssemblyName>
        <PackageId>Ranvier.View.Dom</PackageId>
        <!-- The traced build packs as Ranvier.View.Dom.Traced and depends on Ranvier.View.Traced. -->
        <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.View.Dom.Traced</PackageId>
        <Title>Ranvier.View.Dom</Title>
        <Description>The browser DOM renderer for Ranvier.View: mounting, hydration of server HTML, delegated events and the generated HTML bindings, compiled with Fable.</Description>
        <Description Condition="'$(RanvierTrace)' == 'true'">The traced build of Ranvier.View.Dom: the browser DOM renderer for Ranvier.View. Depends on Ranvier.View.Traced.</Description>
        <PackageTags>reactive;signals;view;dom;hydration;fable;fine-grained;fsharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Alpha release. The API may change before 1.0.</PackageReleaseNotes>
        <!-- Shares its version with Ranvier.View (see Ranvier.View.fsproj). -->
        <Version>0.1.0-alpha.2</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <RanvierExactSiblingVersions>true</RanvierExactSiblingVersions>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="DomEvents.fs" />
        <Compile Include="Scheduling.fs" />
        <Compile Include="Binding.fs" />
        <Compile Include="Microtask.fs" />
        <Compile Include="Generated/Html.fs" />
        <Compile Include="Prepared.fs" />
        <Compile Include="Placement.fs" />
        <Compile Include="Inspect.fs" />
        <Compile Include="TemplateDom.fs" />
        <Compile Include="DocumentHead.fs" />
        <Compile Include="Mounting.fs" />
        <Compile Include="Hydration.fs" />
        <Compile Include="PageClient.fs" />
        <Compile Include="Debug.fs" />
        <Compile Include="Components.fs" />
        <Compile Include="Authoring.fs" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Ranvier.View/Ranvier.View.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ranvier.View.Twin" />
        <InternalsVisibleTo Include="Ranvier.View.Twin.Tests" />
    </ItemGroup>

    <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
        <AssemblyMetadata Include="RanvierTrace" Value="true" />
    </ItemGroup>

</Project>
