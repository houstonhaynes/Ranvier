<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
        <RootNamespace>Ranvier.Anime</RootNamespace>
        <AssemblyName>Fable.Ranvier.Anime</AssemblyName>
        <PackageId>Fable.Ranvier.Anime</PackageId>
        <!-- The traced build packs as Fable.Ranvier.Anime.Traced and depends on Ranvier.Traced. -->
        <PackageId Condition="'$(RanvierTrace)' == 'true'">Fable.Ranvier.Anime.Traced</PackageId>
        <Title>Fable.Ranvier.Anime</Title>
        <Description>Typed anime.js 4.5 bindings for Fable, with Ranvier integration: parameters as constructors with named optional arguments, and per-feature imports.</Description>
        <Description Condition="'$(RanvierTrace)' == 'true'">The traced build of Fable.Ranvier.Anime: typed anime.js 4.5 bindings for Fable. Depends on Ranvier.Traced.</Description>
        <PackageTags>animation;animejs;bindings;fable;reactive;signals;fsharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Alpha release. The API may change before 1.0.</PackageReleaseNotes>
        <!-- Shares its version with Ranvier.View (see src/Ranvier.View/Ranvier.View.fsproj). -->
        <Version>0.1.0-alpha.1</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <RanvierExactSiblingVersions>true</RanvierExactSiblingVersions>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Values.fs" />
        <Compile Include="Tickables.fs" />
        <Compile Include="Params.fs" />
        <Compile Include="Anime.fs" />
        <Compile Include="Reactive.fs" />
        <Compile Include="Testing.fs" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ranvier\Ranvier.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Temporary: Xantham.Fable.Core.TS 0.2.x restores from the xantham Cloudsmith feed (nuget.config) until it is
             published to nuget.org. -->
        <PackageReference Include="Xantham.Fable.Core.TS" Version="0.2.1" />
    </ItemGroup>

    <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
        <AssemblyMetadata Include="RanvierTrace" Value="true" />
    </ItemGroup>

</Project>
