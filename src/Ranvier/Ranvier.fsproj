<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <!-- The JIT compiles a method with a `tail.` call straight to full
             opts, so it never reaches Tier1 and its PGO-guided inlining. -->
        <Tailcalls>false</Tailcalls>
        <RootNamespace>Ranvier</RootNamespace>
        <AssemblyName>Ranvier</AssemblyName>
        <PackageId>Ranvier</PackageId>
        <!-- An explicit `-p:RanvierTrace=true` packs the traced build under its own id. The Debug
             default is not visible here, so a default traced build keeps `Ranvier` and cannot pack. -->
        <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.Traced</PackageId>
        <Title>Ranvier</Title>
        <Description>Fine-grained reactive computation for .NET: signals, memos and effects on an explicit graph, with async sources that carry a Pending state and boundaries that decide where a pending or failed read stops.</Description>
        <Description Condition="'$(RanvierTrace)' == 'true'">The traced build of Ranvier: the same assembly, namespaces and version, with the per-graph event log and its queries compiled in.</Description>
        <PackageTags>reactive;reactivity;signals;memo;effects;fine-grained;fsharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>0.1.0-preview.5</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <!-- `RanvierAotClean` compiles the untraced build reflection-free and marks it trimmable and AOT-compatible
         (Directory.Build.targets). tests/Ranvier.AotSmoke checks that claim at publish time. -->
    <PropertyGroup>
        <RanvierAotClean>true</RanvierAotClean>
    </PropertyGroup>

    <!-- `-p:RanvierCounters=true` compiles in the operation counts in
         `Counters.fs`. Pass it as a global property, so every project in the
         build sees the same define. -->
    <PropertyGroup Condition="'$(RanvierCounters)' == 'true'">
        <DefineConstants>$(DefineConstants);RANVIER_COUNTERS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compile-time only on .NET: attributes and the `JS.Map` / `JS.Set`
             bindings. Every `[<Emit>]` member in `Platform.fs` has an F# body
             behind `#if`. -->
        <PackageReference Include="Fable.Core" Version="5.3.0" />
    </ItemGroup>

    <!-- TraceModel.fs reads dumps with System.Text.Json, which .NET ships and netstandard2.1 does not. -->
    <ItemGroup Condition="'$(RanvierTrace)' == 'true' and '$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="System.Text.Json" Version="8.0.5" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Counters.fs" Condition="'$(RanvierCounters)' == 'true'" />
        <Compile Include="Types.fs" />
        <Compile Include="PlatformDispatcher.fs" />
        <Compile Include="Platform.fs" />
        <Compile Include="TimedClock.fs" />
        <Compile Include="Positional.fs" />
        <Compile Include="TraceEvents.fs" Condition="'$(RanvierTrace)' == 'true'" />
        <Compile Include="TraceSite.fs" Condition="'$(RanvierTrace)' == 'true'" />
        <Compile Include="Trace.fs" />
        <Compile Include="Core.fs" />
        <Compile Include="Bindings.fs" />
        <Compile Include="Timed.fs" />
        <Compile Include="Deltas.fs" />
        <Compile Include="ValueReaders.fs" />
        <Compile Include="Projections.fs" />
        <Compile Include="Collections.fs" />
        <Compile Include="Api.fs" />
        <Compile Include="Combinators.fs" />
        <Compile Include="TraceModel.fs" Condition="'$(RanvierTrace)' == 'true'" />
        <Compile Include="TraceApi.fs" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- `RanvierTrace` defaults, its define and the traced-pack guard live in Directory.Build.targets.
         A traced assembly says so in its metadata. -->
    <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
        <AssemblyMetadata Include="RanvierTrace" Value="true" />
    </ItemGroup>

</Project>
