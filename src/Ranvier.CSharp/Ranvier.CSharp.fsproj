<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Ranvier.CSharp</RootNamespace>
        <AssemblyName>Ranvier.CSharp</AssemblyName>
        <PackageId>Ranvier.CSharp</PackageId>
        <!-- As for Ranvier: the traced build packs as Ranvier.CSharp.Traced and depends on Ranvier.Traced. -->
        <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.CSharp.Traced</PackageId>
        <Title>Ranvier.CSharp</Title>
        <Description>C# entry points for Ranvier: delegate-based factories and extension methods.</Description>
        <Description Condition="'$(RanvierTrace)' == 'true'">The traced build of Ranvier.CSharp: C# entry points for Ranvier, with the tracing queries compiled in. Depends on Ranvier.Traced.</Description>
        <PackageTags>reactive;reactivity;signals;memo;effects;fine-grained;csharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>0.1.1-preview.1</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <!-- `RanvierAotClean` compiles the untraced build reflection-free and marks it trimmable and AOT-compatible
         (Directory.Build.targets). tests/Ranvier.AotSmoke checks that claim at publish time. -->
    <PropertyGroup>
        <RanvierAotClean>true</RanvierAotClean>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Bindings.fs" />
        <Compile Include="StreamSources.fs" />
        <Compile Include="Reactive.fs" />
        <Compile Include="Extensions.fs" />
        <Compile Include="Tracing.fs" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Ranvier/Ranvier.fsproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
        <AssemblyMetadata Include="RanvierTrace" Value="true" />
    </ItemGroup>

</Project>
