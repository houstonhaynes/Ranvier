<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
        <OutputType>Library</OutputType>
        <RootNamespace>Ranvier.View.Anime</RootNamespace>
        <AssemblyName>Ranvier.View.Anime</AssemblyName>
        <PackageId>Ranvier.View.Anime</PackageId>
        <!-- The traced build packs as Ranvier.View.Anime.Traced and depends on the traced view and anime packages. -->
        <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.View.Anime.Traced</PackageId>
        <Title>Ranvier.View.Anime</Title>
        <Description>Motion parts for Ranvier.View templates over anime.js: lifecycle, enter and exit, FLIP and signal-driven animation, omitted by the server renderer.</Description>
        <Description Condition="'$(RanvierTrace)' == 'true'">The traced build of Ranvier.View.Anime: motion parts for Ranvier.View templates over anime.js. Depends on Ranvier.View.Traced and Fable.Ranvier.Anime.Traced.</Description>
        <PackageTags>reactive;signals;view;animation;animejs;fable;fsharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Alpha release. The API may change before 1.0.</PackageReleaseNotes>
        <!-- Shares its version with Ranvier.View (see Ranvier.View.fsproj). -->
        <Version>0.1.0-alpha.1</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <RanvierExactSiblingVersions>true</RanvierExactSiblingVersions>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Motion.fs" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Ranvier.View/Ranvier.View.fsproj" />
        <ProjectReference Include="../Fable.Ranvier.Anime/Fable.Ranvier.Anime.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ranvier.View.Anime.Tests" />
    </ItemGroup>

    <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
        <AssemblyMetadata Include="RanvierTrace" Value="true" />
    </ItemGroup>

</Project>
