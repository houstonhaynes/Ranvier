<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.0.0-alpha8" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <ProjectReference Include="../../tools/Ranvier.Css.Generate/Ranvier.Css.Generate.fsproj" />
    <ProjectReference Include="../../src/Ranvier.Css/Ranvier.Css.fsproj" />
    <ProjectReference Include="../../src/Ranvier.Css.Build/Ranvier.Css.Build.fsproj" />
    <ProjectReference Include="../../src/Ranvier.Css.View/Ranvier.Css.View.fsproj" />
    <Compile Include="ResolutionTests.fs" />
    <Compile Include="NumericSemanticsTests.fs" />
    <Compile Include="SpecSourcesTests.fs" />
    <Compile Include="GenerationTests.fs" />
    <Compile Include="RuntimeTests.fs" />
    <Compile Include="ConditionalRuntimeTests.fs" />
    <Compile Include="UtilityTests.fs" />
    <Compile Include="BuildTests.fs" />
    <Compile Include="ViewTests.fs" />
    <Compile Include="UtilityViewTests.fs" />
    <Compile Include="Tests.fs" />
  </ItemGroup>
</Project>
