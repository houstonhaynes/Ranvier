<Project Sdk="Microsoft.NET.Sdk">

    <!--
    A NativeAOT app over Ranvier, Ranvier.CSharp and Ranvier.Elmish. `dotnet publish -c Release -r linux-x64` fails on any
    IL2xxx/IL3xxx warning: the assemblies are rooted, so ILC analyses their whole public surface. The published
    binary exits non-zero when an exception or a ToString text differs from the JIT build's.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <PublishAot>true</PublishAot>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../TraceTextCases.fs" Link="TraceTextCases.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Ranvier/Ranvier.fsproj" />
        <ProjectReference Include="../../src/Ranvier.CSharp/Ranvier.CSharp.fsproj" />
        <ProjectReference Include="../../src/Ranvier.Elmish/Ranvier.Elmish.fsproj" />
        <ProjectReference Include="../../src/Ranvier.Query/Ranvier.Query.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="Ranvier" />
        <TrimmerRootAssembly Include="Ranvier.CSharp" />
        <TrimmerRootAssembly Include="Ranvier.Elmish" />
        <TrimmerRootAssembly Include="Ranvier.Query" />
    </ItemGroup>

</Project>
