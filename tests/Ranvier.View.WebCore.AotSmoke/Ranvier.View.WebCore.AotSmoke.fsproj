<Project Sdk="Microsoft.NET.Sdk">

    <!--
    A NativeAOT app over Ranvier.View.WebCore: it mounts a component on a WebCore page, clicks it through native input
    and paints it. `dotnet publish -c Release -r win-x64` builds it; the published binary exits non-zero on a failed
    step.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <PublishAot>true</PublishAot>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Ranvier/Ranvier.fsproj" />
        <ProjectReference Include="../../src/Ranvier.View/Ranvier.View.fsproj" />
        <ProjectReference Include="../../src/Ranvier.View.Dom/Ranvier.View.Dom.fsproj" />
        <ProjectReference Include="../../src/Ranvier.View.WebCore/Ranvier.View.WebCore.fsproj" />
    </ItemGroup>

</Project>
