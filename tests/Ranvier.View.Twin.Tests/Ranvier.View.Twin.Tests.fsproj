<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>
    <!-- `-p:RanvierCounters=true` compiles the tests that read the core's operation counts. -->
    <PropertyGroup Condition="'$(RanvierCounters)' == 'true'">
        <DefineConstants>$(DefineConstants);RANVIER_COUNTERS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="NativeTests.fs" />
        <Compile Include="ModuleInitTests.fs" />
        <Compile Include="SeamTests.fs" />
        <Compile Include="TreeTests.fs" />
        <Compile Include="HtmlTests.fs" />
        <Compile Include="BridgeTests.fs" />
        <Compile Include="EventTests.fs" />
        <Compile Include="SelectorTests.fs" />
        <Compile Include="Fixtures.fs" />
        <Compile Include="ClockTests.fs" />
        <Compile Include="SessionTests.fs" />
        <Compile Include="AsyncTests.fs" />
        <Compile Include="DepartureTests.fs" />
        <Compile Include="HeadTests.fs" />
        <Compile Include="InspectTests.fs" />
        <Compile Include="RowMetadataTests.fs" />
        <Compile Include="DumpTests.fs" />
        <Compile Include="../../experiments/Ranvier.View.Checks/ServerFixtures.fs" Link="Checks/ServerFixtures.fs" />
        <Compile Include="../../experiments/Ranvier.View.Checks/ServerChecks.fs" Link="Checks/ServerChecks.fs" />
        <Compile Include="OracleTests.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/RangeChecks.fs" Link="Checks/RangeChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/DelegationChecks.fs" Link="Checks/DelegationChecks.fs" />
        <Compile Include="../../experiments/Ranvier.View.Checks/Browser.fs" Link="Checks/Browser.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/TemplateChecks.fs" Link="Checks/TemplateChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/TestingApiChecks.fs" Link="Checks/TestingApiChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/BoundaryChecks.fs" Link="Checks/BoundaryChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/CheckSupport.fs" Link="Checks/CheckSupport.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/PlacementChecks.fs" Link="Checks/PlacementChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/TemplateCatalogueChecks.fs" Link="Checks/TemplateCatalogueChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/UnsafeHtmlChecks.fs" Link="Checks/UnsafeHtmlChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/DocumentChecks.fs" Link="Checks/DocumentChecks.fs" />
        <Compile Include="../../experiments/Ranvier.View.Checks/SugarFixtures.fs" Link="Checks/SugarFixtures.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/HydrationChecks.fs" Link="Checks/HydrationChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/PlaygroundSugar.fs" Link="Checks/PlaygroundSugar.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/KeyedRowsPerf.fs" Link="Checks/KeyedRowsPerf.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/KeyedRowsSugarPerf.fs" Link="Checks/KeyedRowsSugarPerf.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/SugarChecks.fs" Link="Checks/SugarChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/PendingRegionChecks.fs" Link="Checks/PendingRegionChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/OwnedAsyncChecks.fs" Link="Checks/OwnedAsyncChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/DepartureChecks.fs" Link="Checks/DepartureChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/DumpChecks.fs" Link="Checks/DumpChecks.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/LoopBench.fs" Link="Checks/LoopBench.fs" />
        <Compile Include="../../examples/Fable.Ranvier.Playground/tests/ConformanceCases.fs" Link="Checks/ConformanceCases.fs" />
        <Compile Include="ServerParityTests.fs" />
        <Compile Include="TwinHarness.fs" />
        <Compile Include="ConformanceTests.fs" />
        <Compile Include="GoldenTests.fs" />
        <Compile Include="MembersTests.fs" />
        <Compile Include="TestingApiTests.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8" />
        <!-- A test-only oracle for the twin parser and serialiser (spec decision 2); never a dependency of Ranvier.View.Twin. -->
        <PackageReference Include="AngleSharp" Version="1.8.5" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Ranvier/Ranvier.fsproj" />
        <ProjectReference Include="../../src/Fable.Ranvier/Fable.Ranvier.fsproj" />
        <ProjectReference Include="../../src/Ranvier.View/Ranvier.View.fsproj" />
        <ProjectReference Include="../../src/Ranvier.View.Dom/Ranvier.View.Dom.fsproj" />
        <ProjectReference Include="../../experiments/Ranvier.View.Twin/Ranvier.View.Twin.fsproj" />
    </ItemGroup>
</Project>
