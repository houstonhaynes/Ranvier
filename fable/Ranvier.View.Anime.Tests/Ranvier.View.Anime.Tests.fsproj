<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The Ranvier.View.Anime parts: compiled with Fable and run under the Node test runner with jsdom and a mocked clock
    (npm test), and run on .NET as the server-render check (dotnet run).
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Fixtures.fs" />
        <Compile Include="SizeEntries.fs" />
        <Compile Include="MotionChecks.fs" />
        <Compile Include="ServerChecks.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\experiments\Ranvier.View.Foundation\Ranvier.View.Foundation.fsproj" />
        <ProjectReference Include="..\..\experiments\Ranvier.View.Anime\Ranvier.View.Anime.fsproj" />
        <PackageReference Update="FSharp.Core" Version="10.1.401" />
    </ItemGroup>

</Project>
