<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DefineConstants Condition="'$(CapsQuote)' == 'true'">$(DefineConstants);CAPS_QUOTE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Caps.fs" />
    <PackageReference Include="Fable.Core" Version="5.3.0" />
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
  </ItemGroup>
</Project>
