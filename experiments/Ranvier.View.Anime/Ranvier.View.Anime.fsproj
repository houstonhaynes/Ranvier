<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <FSharpCoreImplicitPackageVersion>8.0.100</FSharpCoreImplicitPackageVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Motion.fs" />
    <ProjectReference Include="../Ranvier.View.Portable/Ranvier.View.Portable.fsproj" />
    <ProjectReference Include="../../src/Fable.Ranvier.Anime/Fable.Ranvier.Anime.fsproj" />
    <InternalsVisibleTo Include="Ranvier.View.Anime.Tests" />
  </ItemGroup>
</Project>
