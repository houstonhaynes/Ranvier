<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="PackagingChecks.fs" />
    <Compile Include="ServerFixtures.fs" />
    <Compile Include="ServerChecks.fs" />
    <Compile Include="SugarFixtures.fs" />
    <Compile Include="SugarServerChecks.fs" />
    <Compile Include="../Ranvier.View.Arms/Checks/ArmsFixtures.fs" Link="Checks/ArmsFixtures.fs" />
    <Compile Include="../Ranvier.View.Arms/Checks/ArmsServerChecks.fs" Link="Checks/ArmsServerChecks.fs" />
