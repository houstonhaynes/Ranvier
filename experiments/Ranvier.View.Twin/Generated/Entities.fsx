// Writes Entities.fs: the HTML named character references (the 2231 names of the WHATWG table, each with and without
// its legacy semicolon-less form where the table has one), read from AngleSharp 1.8.5's entity provider in the NuGet
// cache. Run from the repository root after `dotnet restore tests/Ranvier.View.Twin.Tests`:
//   dotnet fsi experiments/Ranvier.View.Twin/Generated/Entities.fsx
#r "nuget: AngleSharp, 1.8.5"

open System
open System.IO
open System.Text

let provider = typeof<AngleSharp.Html.HtmlEntityProvider>
let flags = Reflection.BindingFlags.Public ||| Reflection.BindingFlags.NonPublic ||| Reflection.BindingFlags.Static ||| Reflection.BindingFlags.Instance
let instance = (provider.GetField ("Instance", flags)).GetValue null
let table = (provider.GetField ("_entities", flags)).GetValue instance :?> Collections.IDictionary

let entries =
    [
        for first in table.Keys do
            let inner = table[first] :?> Collections.IDictionary

            for name in inner.Keys do
                string name, string inner[name]
    ]
    |> List.sortBy fst

let literal (value: string) =
    let out = StringBuilder "\""

    for c in value do
        if c >= ' ' && int c < 0x7f && c <> '"' && c <> char 92 then
            out.Append c |> ignore
        else
            out.Append(char 92).Append (sprintf "u%04X" (int c)) |> ignore

    out.Append('"').ToString ()

let text = StringBuilder ()
text.AppendLine "// Generated by Entities.fsx from AngleSharp 1.8.5's entity table; do not edit." |> ignore
text.AppendLine "/// <summary>The HTML named character references: each name, with its semicolon when the name has one, and its text.</summary>" |> ignore
text.AppendLine "module internal Ranvier.View.Twin.Entities" |> ignore
text.AppendLine () |> ignore
text.AppendLine "let table =" |> ignore
text.AppendLine "    dict [|" |> ignore

for name, value in entries do
    text.AppendLine $"        {literal name}, {literal value}" |> ignore

text.AppendLine "    |]" |> ignore
File.WriteAllText (Path.Combine (__SOURCE_DIRECTORY__, "Entities.fs"), text.ToString ())
printfn "%d entries" entries.Length
