<Project Sdk="Microsoft.NET.Sdk">

    <!-- Shared Motion pages, compiled with Fable and bundled by Vite. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="src/Page.fs" />
        <Compile Include="src/Kanban.fs" />
        <Compile Include="src/Dashboard.fs" />
        <Compile Include="src/Story.fs" />
        <Compile Include="src/StoryClient.fs" />
        <Compile Include="src/Physics.fs" />
        <Compile Include="src/Routes.fs" />
        <Compile Include="src/Graphs.fs" />
        <Compile Include="src/PageLayout.fs" />
        <Compile Include="src/KanbanPage.fs" />
        <Compile Include="src/DashboardPage.fs" />
        <Compile Include="src/StoryPage.fs" />
        <Compile Include="src/PhysicsPage.fs" />
        <Compile Include="src/RoutesPage.fs" />
        <Compile Include="src/GraphsPage.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Ranvier.View.Dom/Ranvier.View.Dom.fsproj" />
        <ProjectReference Include="../../src/Ranvier.View.Anime/Ranvier.View.Anime.fsproj" />
        <ProjectReference Include="../../src/Ranvier.Elmish/Ranvier.Elmish.fsproj" />
        <ProjectReference Include="../../src/Ranvier.Wire/Ranvier.Wire.fsproj" />
        <PackageReference Update="FSharp.Core" Version="10.1.401" />
    </ItemGroup>

</Project>
