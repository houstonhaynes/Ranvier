<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The story page on .NET: renders it with Server.render under its Omit policy, checks the render equals its
    twin without Motion parts, and given a write path writes the render there for the Vite server to serve (npm run server).
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../src/Story.fs" />
        <Compile Include="StoryTwin.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../experiments/Ranvier.View.Portable/Ranvier.View.Portable.fsproj" />
        <ProjectReference Include="../../../experiments/Ranvier.View.Anime/Ranvier.View.Anime.fsproj" />
        <PackageReference Update="FSharp.Core" Version="10.1.401" />
    </ItemGroup>

</Project>
