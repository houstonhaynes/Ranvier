<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The page checks of the Motion examples: compiled with Fable (npm run compile:tests) and run under the Node test runner
    with jsdom and a mocked clock (tests/pages.test.mjs). The browser checks are the *.spec.mjs files beside them.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Harness.fs" />
        <Compile Include="KanbanChecks.fs" />
        <Compile Include="DashboardChecks.fs" />
        <Compile Include="StoryChecks.fs" />
        <Compile Include="PhysicsChecks.fs" />
        <Compile Include="RoutesChecks.fs" />
        <Compile Include="Checks.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Motion.fsproj" />
        <PackageReference Update="FSharp.Core" Version="10.1.401" />
    </ItemGroup>

</Project>
