{
  "name": "ranvier-motion-examples",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "compile": "npm run server && npm run compile:client",
    "compile:client": "dotnet fickl Client.fsproj --outDir generated --configuration Release",
    "compile:tests": "dotnet fickl tests/MotionTests.fsproj --outDir generated-tests --configuration Release",
    "server": "dotnet build Server/ServerChecks.fsproj -c Release -m:1 -p:BuildInParallel=false && dotnet run --project Server/ServerChecks.fsproj -c Release --no-build -- --write-pages",
    "dev": "npm run compile && vite --host 127.0.0.1",
    "serve:test": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "npm run compile && vite build",
    "size": "npm run build && node size.mjs",
    "size:only": "vite build && node size.mjs",
    "test:dom": "npm run compile:tests && node --test tests/pages.test.mjs",
    "test:browser": "npm run compile && playwright test",
    "test:build": "node --test tests/build.test.mjs tests/development.test.mjs",
    "test": "npm run test:build && npm run test:dom && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "animejs": "4.5.0",
    "jsdom": "30.1.3",
    "vite": "8.3.4"
  }
}
