{
  "name": "ranvier-motion-examples",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "compile": "dotnet fickl Motion.fsproj --outDir generated --configuration Release",
    "compile:tests": "dotnet fickl tests/MotionTests.fsproj --outDir generated-tests --configuration Release",
    "server": "dotnet run --project Server/ServerChecks.fsproj -c Release -- --write generated-server/story.html",
    "dev": "npm run server && dotnet fickl watch Motion.fsproj --outDir generated --configuration Release --run vite --host 127.0.0.1",
    "serve:test": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "npm run compile && vite build",
    "size": "npm run build && node size.mjs",
    "size:only": "vite build && node size.mjs",
    "test:dom": "npm run compile:tests && node --test tests/pages.test.mjs",
    "test:browser": "npm run compile && npm run server && playwright test",
    "test": "npm run test:dom && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "animejs": "4.5.0",
    "jsdom": "30.1.1",
    "vite": "8.3.3"
  }
}
