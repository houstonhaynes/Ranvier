<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <!-- BenchmarkDotNet refuses to run a Debug build, and is right to. -->
        <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <!-- Measurements are the product here; the docs would be noise. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Config.fs" />
        <Compile Include="Signals.fs" />
        <Compile Include="Timed.fs" />
        <Compile Include="Memos.fs" />
        <Compile Include="Effects.fs" />
        <Compile Include="Bindings.fs" />
        <Compile Include="Suspension.fs" />
        <Compile Include="Lifetimes.fs" />
        <Compile Include="Projections.fs" />
        <Compile Include="Lists.fs" />
        <Compile Include="DeltaReaders.fs" />
        <Compile Include="Comparisons.fs" />
        <Compile Include="Commands.fs" />
        <Compile Include="Models.fs" />
        <Compile Include="Queries.fs" />
        <Compile Include="Tracing.fs" />
        <Compile Include="Probe.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="FSharp.Data.Adaptive" Version="1.2.27" />
        <PackageReference Include="R3" Version="1.3.1" />
        <PackageReference Include="System.Reactive" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Ranvier\Ranvier.fsproj" />
        <ProjectReference Include="..\..\src\Ranvier.Elmish\Ranvier.Elmish.fsproj" />
        <ProjectReference Include="..\..\src\Ranvier.Query\Ranvier.Query.fsproj" />
        <ProjectReference Include="..\..\src\Ranvier.CSharp\Ranvier.CSharp.fsproj" />
    </ItemGroup>

</Project>
