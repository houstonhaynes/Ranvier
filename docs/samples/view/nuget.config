<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The root configuration: docs/nuget.config replaces it for the docs site, whose feed lacks the Xantham packages these samples restore. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="partas-build" value="https://nuget.cloudsmith.io/shayanhabibi/shayanhabibi-partas-build/v3/index.json" />
    <add key="xantham-cloudsmith" value="https://nuget.cloudsmith.io/shayanhabibi/xantham/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="partas-build">
      <package pattern="Partas.Build" />
      <package pattern="Partas.Build.Cmd" />
      <package pattern="Partas.Build.Baked" />
    </packageSource>
    <packageSource key="xantham-cloudsmith">
      <package pattern="Xantham.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
