<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles every F# sample of docs/content/view and docs/content/server, and checks the HTML the pages quote. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Counter.fs" />
    <Compile Include="CounterExplicit.fs" />
    <Compile Include="Main.fs" />
    <Compile Include="IndexTaste.fs" />
    <Compile Include="Templates.fs" />
    <Compile Include="Components.fs" />
    <Compile Include="Collections.fs" />
    <Compile Include="Arms.fs" />
    <Compile Include="Boundaries.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="DocumentHead.fs" />
    <Compile Include="ElmishView.fs" />
    <Compile Include="Lifetimes.fs" />
    <Compile Include="SugarOpens.fs" />
    <Compile Include="Authored.fs" />
    <Compile Include="FableRanvier.fs" />
    <Compile Include="CounterHtml.fs" />
    <Compile Include="CounterChecks.fs" />
    <Compile Include="Shared.fs" />
    <Compile Include="StateTransfer.fs" />
    <Compile Include="ServerPage.fs" />
    <Compile Include="DeploymentEndpoint.fs" />
    <Compile Include="Client.fs" />
    <Compile Include="Rendering.fs" />
    <Compile Include="ServerOverview.fs" />
    <Compile Include="MotionBindings.fs" />
    <Compile Include="MotionReactive.fs" />
    <Compile Include="MotionParts.fs" />
    <Compile Include="MotionTesting.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../experiments/Ranvier.View.Foundation/Ranvier.View.Foundation.fsproj" />
    <ProjectReference Include="../../../experiments/Ranvier.View.Anime/Ranvier.View.Anime.fsproj" />
    <ProjectReference Include="../../../src/Ranvier.Elmish/Ranvier.Elmish.fsproj" />
    <ProjectReference Include="../../../src/Ranvier.Wire/Ranvier.Wire.fsproj" />
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
  </ItemGroup>
</Project>
