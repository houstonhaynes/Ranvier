<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="partas-local" value="feed" />
  </packageSources>
  <packageSourceMapping>
    <!-- Replaces the root mapping, whose Xantham.* pattern names a source this file clears. -->
    <clear />
    <!-- Unpublished packages, committed under feed/: Partas.Nacara.Plugins.Solid (Partas.Nacara.Plugins
         08bba7a), Partas.Solid 3 for the live examples it compiles (Partas.Solid e08ad85), and
         Nacara.Plugin.LiveExample with preset properties and stylesheets (Nacara 8983a1d). -->
    <packageSource key="partas-local">
      <package pattern="Partas.Nacara.Plugins.Solid" />
      <package pattern="Partas.Solid" />
      <package pattern="Partas.Solid.FablePlugin" />
      <package pattern="Nacara.Plugin.LiveExample" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
