<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Spec.fs" />
        <Compile Include="Theme.fs" />
        <Compile Include="Directives.fs" />
        <Compile Include="MenuCoverage.fs" />
        <Compile Include="Site.fs" />
        <Content Include="content\**" CopyToOutputDirectory="Never" />
        <Content Include="static\**" CopyToOutputDirectory="Never" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Nacara.Core" Version="2.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Markdown" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Literate" Version="1.0.0-beta.1" />
        <PackageReference Include="Nacara.Plugin.FSharpApi" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Highlight.TreeSitter" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Sitemap" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.LinkValidator" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Versions" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Assets.LightningCss" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Assets.Esbuild" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Assets.Nuglify" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.LiveExample" Version="1.0.0-local.8983a1d" />
        <!-- Restored before Site initialisation, including check-menus; the browser checker consumes these DLLs. -->
        <PackageReference Include="Xantham.Fable.Core.TS" Version="0.2.1" />
        <PackageReference Include="Xantham.Fable.Core" Version="0.2.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="plugin/Nacara.Plugin.Ranvier.fsproj" />
        <ProjectReference Include="maps/model/Ranvier.Docs.MapModel.fsproj" />
        <!-- Builds the libraries beside the site, where the API reference reads them. -->
        <ProjectReference Include="../src/Ranvier.CSharp/Ranvier.CSharp.fsproj" />
        <ProjectReference Include="../src/Ranvier.Elmish/Ranvier.Elmish.fsproj" />
        <ProjectReference Include="../src/Ranvier.Query/Ranvier.Query.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- The Partas.Nacara packages were built with the .NET 11 SDK and need FSharp.Core 11;
             without this, the implicit FSharp.Core of an older SDK wins and the site fails to start. -->
        <PackageReference Include="FSharp.Core" Version="11.0.101-rc1.26425.128" />
        <PackageReference Include="Partas.Nacara.Theme" Version="0.2.0" />
        <PackageReference Include="Partas.Nacara.Plugins.Directives" Version="0.1.0" />
        <PackageReference Include="Partas.Nacara.Plugins.AgentFriendly" Version="0.1.0" />
        <PackageReference Include="Partas.Nacara.Plugins.OgImage" Version="0.1.0" />
    </ItemGroup>
</Project>
