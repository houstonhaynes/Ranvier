<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- docs/literate.fsx loads the view assemblies from this output directory. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="PipelineFixture.fs" />
        <Compile Include="SignalMap.fs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ranvier.Docs.Maps.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="model\Ranvier.Docs.MapModel.fsproj" />
        <!-- Fable compiles package sources ahead of project references, so view packages would compile before the
             core project they depend on. The view projects compile from source, against this core. -->
        <ProjectReference Include="$(RanvierViewRoot)\src\Ranvier.View.Dom\Ranvier.View.Dom.fsproj" />
        <ProjectReference Include="$(RanvierViewRoot)\src\Fable.Ranvier.Anime\Fable.Ranvier.Anime.fsproj" />
    </ItemGroup>

    <Target Name="ValidateRanvierViews" BeforeTargets="CollectPackageReferences;PrepareForBuild">
        <Error Condition="!Exists('$(RanvierViewRoot)/Local.Build.props')" Text="RanvierViewRoot must point to a ranvier-org/Ranvier.View checkout built against this core. Run .github/scripts/view-sibling.sh." />
    </Target>

</Project>
