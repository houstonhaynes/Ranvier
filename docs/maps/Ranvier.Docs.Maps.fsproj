<Project Sdk="Microsoft.NET.Sdk">

    <!-- Compiled by Fable only, through the docs' Solid workspace. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsExcludedFromRootBuild>true</IsExcludedFromRootBuild>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="SignalMap.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Partas.Solid" Version="3.0.0-local.e08ad85" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="model\Ranvier.Docs.MapModel.fsproj" />
        <ProjectReference Include="..\..\src\Fable.Ranvier.Anime\Fable.Ranvier.Anime.fsproj" />
    </ItemGroup>

</Project>
