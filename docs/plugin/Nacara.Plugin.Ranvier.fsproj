<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0-alpha.1</Version>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <Description>Ranvier.View components and interactive signal maps in Nacara Markdown pages.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Compile Include="../maps/authoring/MapFence.fs" Link="Authoring/MapFence.fs" />
    <Compile Include="../maps/authoring/MapCode.fs" Link="Authoring/MapCode.fs" />
    <Compile Include="../maps/authoring/MapPage.fs" Link="Authoring/MapPage.fs" />
    <Compile Include="../maps/authoring/FenceScanner.fs" Link="Authoring/FenceScanner.fs" />
    <Compile Include="../maps/authoring/MapWorkspace.fs" Link="Authoring/MapWorkspace.fs" />
    <Compile Include="LiveExampleMetadata.fs" />
    <Compile Include="RanvierExamples.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="11.0.101-rc1.26425.128" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Nacara.Core" Version="2.0.0-beta.6" />
    <PackageReference Include="Nacara.Plugin.Assets.Esbuild" Version="1.0.0-beta.1" />
  </ItemGroup>
</Project>
