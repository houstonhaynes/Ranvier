<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <FSharpAnalyzersContinueOnError>true</FSharpAnalyzersContinueOnError>
    <FSharpAnalyzersOtherFlags>--analyzers-path &quot;$(MSBuildThisFileDirectory)../Analyzer/bin/Release/net10.0&quot; --fail-on-type-errors --treat-as-error RAN002</FSharpAnalyzersOtherFlags>
  </PropertyGroup>
  <ItemGroup><Compile Include="A.fs" /><Compile Include="B.fs" /></ItemGroup>
  <ItemGroup><PackageReference Include="FSharp.Analyzers.Build" Version="0.5.0" PrivateAssets="all" IncludeAssets="build" /></ItemGroup>
</Project>
